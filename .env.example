# Public URL of the site (canonical URLs, sitemap, Open Graph). Set the final domain in Vercel.
NEXT_PUBLIC_SITE_URL=https://www.drsalud.mx

# "Solicitar propuesta" form delivery (Resend). Server-only: never prefix with NEXT_PUBLIC_.
# Without them: development logs the request to the console; production shows an error with the WhatsApp alternative.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
